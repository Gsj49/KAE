# Keep configuration and small numeric inputs in Git; distribute larger data separately.
*
!.gitignore
!README.md
!paths.json
!check.py
!*_assets.json
!*/
!**/.gitkeep

# Small numeric inputs for the two appendix summary tables.
!/mc_error/*.csv
!/computing_cost/*.csv
!/computing_cost/*.csv.gz

# Compact reward samples for CPU value MSE.
!/value_mse/gsm8k/*.parquet
!/value_mse/math/*.parquet
